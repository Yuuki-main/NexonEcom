  partner
  internal

  @@map("organization_type_enum")
  @@schema("identity")
}

enum OrganizationStatus {
  active
  suspended
  closed

  @@map("organization_status_enum")
  @@schema("identity")
}

enum OrganizationMemberRole {
  owner
  admin
  purchaser
  viewer

  @@map("organization_member_role_enum")
  @@schema("identity")
}

enum OrganizationMemberStatus {
  invited
  active
  removed

  @@map("organization_member_status_enum")
  @@schema("identity")
}

enum CellType {
  n_type
  p_type

  @@map("cell_type_enum")
  @@schema("catalog")
}

enum OrderStatus {
  pending_payment
  paid
  processing
  shipped
  delivered
  cancelled
  refunded

  @@map("order_status_enum")
  @@schema("commerce")
}

enum LeadStatus {

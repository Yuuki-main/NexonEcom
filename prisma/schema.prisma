generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["audit", "billing", "catalog", "commerce", "crm", "identity", "inventory", "shared"]
}

model Country {
  isoCode     String    @id(map: "pk_countries") @map("iso_code") @db.Char(2)
  name        String
  callingCode String?   @map("calling_code")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  addresses   Address[]

  @@map("countries")
  @@schema("shared")
}

/// Reusable, editable address-book entries. NOT referenced by orders/invoices
/// directly — those hold an immutable JSONB snapshot (see Order) instead.
model Address {
  id          String    @id(map: "pk_addresses") @default(dbgenerated("shared.uuid_generate_v7()")) @db.Uuid
  line1       String
  line2       String?
  city        String
  state       String?
  postcode    String
  countryCode String    @default("AU") @map("country_code") @db.Char(2)
  latitude    Decimal?  @db.Decimal(9, 6)
  longitude   Decimal?  @db.Decimal(9, 6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  country     Country   @relation(fields: [countryCode], references: [isoCode], map: "fk_addresses_country")

  @@index([countryCode], map: "idx_addresses_country_code")
  @@map("addresses")
  @@schema("shared")
}

/// The anchor B2B entity. Root of nearly every downstream relationship —
/// orders, quotes, credit accounts, invoices all hang off this, not off a person.
/// NOTE: real uniqueness on `abn` is a partial index (see file header) — the
/// @@index below is for lookup performance only, not a uniqueness guarantee.
model Organization {
  id                 String             @id(map: "pk_organizations") @default(dbgenerated("shared.uuid_generate_v7()")) @db.Uuid
  type               OrganizationType   @default(customer)
  legalName          String             @map("legal_name")
  tradingName        String?            @map("trading_name")
  abn                String?            @unique(map: "uq_organizations_abn_active", where: raw("((deleted_at IS NULL) AND (abn IS NOT NULL))"))
  isGstRegistered    Boolean            @default(true) @map("is_gst_registered")
  accountOwnerUserId String?            @map("account_owner_user_id") @db.Uuid
  status             OrganizationStatus @default(active)
  createdByUserId    String?            @map("created_by_user_id") @db.Uuid
  updatedByUserId    String?            @map("updated_by_user_id") @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?          @map("deleted_at") @db.Timestamptz(6)
  businessAddress    String?            @map("business_address")
  billingAddress     String?            @map("billing_address")
  stripeCustomerId   String?            @unique(map: "uq_organizations_stripe_customer_id_active", where: raw("(deleted_at IS NULL)")) @map("stripe_customer_id")

  members     OrganizationMember[]
  teamMembers OrganizationTeamMember[]

  @@index([accountOwnerUserId], map: "idx_organizations_account_owner_user_id")
  @@index([type], map: "idx_organizations_type")
  @@map("organizations")
  @@schema("identity")
}

/// Universal login-capable identity — both customer-portal users (via
/// OrganizationMember) and internal staff (via UserRole). A person, never a company.
/// NOTE: real uniqueness on `email` is a partial + functional index (see file
/// header, `lower(email) WHERE deleted_at IS NULL`) — the @@index below is
/// lookup performance only.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model User {
  id              String    @id(map: "pk_users") @default(dbgenerated("shared.uuid_generate_v7()")) @db.Uuid
  fullName        String    @map("full_name")
  email           String
  passwordHash    String    @map("password_hash")
  phone           String?
  isEmailVerified Boolean   @default(false) @map("is_email_verified")
  isActive        Boolean   @default(true) @map("is_active")
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  organizationMembers OrganizationMember[]

  @@index([isActive], map: "idx_users_is_active")
  @@map("users")
  @@schema("identity")
}

/// Grants a User the ability to act on behalf of an Organization, with a
/// portal-scoped role (owner/admin/purchaser/viewer) — the customer-portal
/// RBAC layer, distinct from platform-staff Role/UserRole below.
/// NOTE: real uniqueness on (organizationId, userId) is a partial index
/// (see file header) — the @@index below is lookup performance only.
model OrganizationMember {
  id              String                   @id(map: "pk_organization_members") @default(dbgenerated("shared.uuid_generate_v7()")) @db.Uuid
  organizationId  String                   @map("organization_id") @db.Uuid
  userId          String                   @map("user_id") @db.Uuid
  role            OrganizationMemberRole   @default(purchaser)
  status          OrganizationMemberStatus @default(active)
  invitedByUserId String?                  @map("invited_by_user_id") @db.Uuid
  invitedAt       DateTime?                @map("invited_at") @db.Timestamptz(6)
  joinedAt        DateTime?                @map("joined_at") @db.Timestamptz(6)
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?                @map("deleted_at") @db.Timestamptz(6)
  subscribeOrders       Boolean @default(true)  @map("subscribe_orders")
  subscribeInvoices     Boolean @default(true)  @map("subscribe_invoices")
  subscribePackingSlips Boolean @default(true)  @map("subscribe_packing_slips")
  subscribeNewsletter   Boolean @default(false) @map("subscribe_newsletter")
  subscribeStatements   Boolean @default(true)  @map("subscribe_statements")

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, userId], map: "uq_org_members_org_user_active", where: raw("(deleted_at IS NULL)"))
  @@index([organizationId, userId], map: "idx_org_members_org_user")
  @@index([userId], map: "idx_org_members_user_id")
  @@map("organization_members")
  @@schema("identity")
}

/// An organization can have multiple addresses (head office + multiple job
/// sites) — this is why addresses aren't a single FK column on Organization.
model OrganizationAddress {
  id                String   @id(map: "pk_organization_addresses") @default(dbgenerated("shared.uuid_generate_v7()")) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  addressId         String   @map("address_id") @db.Uuid
  label             String?
  isDefaultShipping Boolean  @default(false) @map("is_default_shipping")
  isDefaultBilling  Boolean  @default(false) @map("is_default_billing")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, addressId], map: "uq_org_addresses_org_address")
  @@index([organizationId], map: "idx_org_addresses_organization_id")
  @@map("organization_addresses")
  @@schema("identity")
}

/// Operational team member (installer, warehouse pickup contact, etc.) for an
/// organization — distinct from OrganizationMember: not a login-capable User,
/// carries no portal access or role. Plain full unique constraint (no partial
/// index needed) since this model has no soft delete, unlike most identity models.
model OrganizationTeamMember {
  id             String   @id(map: "pk_organization_team_members") @default(dbgenerated("shared.uuid_generate_v7()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  email          String
  phone          String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "fk_org_team_members_organization")

  @@unique([organizationId, email], map: "uq_org_team_members_org_email")
  @@index([organizationId], map: "idx_org_team_members_organization_id")
  @@map("organization_team_members")
  @@schema("identity")
}

/// Internal platform RBAC — staff roles (admin, sales_rep, credit_manager,
/// warehouse_staff, support), decoupled from any customer organization.
model Role {
  id          String   @id(map: "pk_roles") @default(dbgenerated("shared.uuid_generate_v7()")) @db.Uuid
  key         String   @unique(map: "uq_roles_key")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("roles")
  @@schema("identity")
}

/// Pure many-to-many junction — composite PK, no surrogate id (documented
/// exception to the "every table has an id" convention).
model UserRole {
  userId          String   @map("user_id") @db.Uuid
  roleId          String   @map("role_id") @db.Uuid
  grantedByUserId String?  @map("granted_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([userId, roleId], map: "pk_user_roles")
  @@map("user_roles")
  @@schema("identity")
}

/// Refresh-token store — makes sessions revocable and rotatable (fixes the
/// current system's single-JWT-can't-be-invalidated gap).
model Session {
  id                   String    @id(map: "pk_sessions") @default(dbgenerated("shared.uuid_generate_v7()")) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  refreshTokenHash     String    @unique(map: "uq_sessions_refresh_token_hash") @map("refresh_token_hash")
  deviceLabel          String?   @map("device_label")
  ipAddress            String?   @map("ip_address") @db.Inet
  rotatedFromSessionId String?   @map("rotated_from_session_id") @db.Uuid
  expiresAt            DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId], map: "idx_sessions_user_id")
  @@index([expiresAt], map: "idx_sessions_expires_at")
  @@map("sessions")
  @@schema("identity")
}

model PasswordResetToken {
  id        String    @id(map: "pk_password_reset_tokens") @default(dbgenerated("shared.uuid_generate_v7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique(map: "uq_password_reset_tokens_token_hash") @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId], map: "idx_password_reset_tokens_user_id")
  @@map("password_reset_tokens")
  @@schema("identity")
}

model EmailVerificationToken {
  id        String    @id(map: "pk_email_verification_tokens") @default(dbgenerated("shared.uuid_generate_v7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique(map: "uq_email_verification_tokens_token_hash") @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId], map: "idx_email_verification_tokens_user_id")
  @@map("email_verification_tokens")
  @@schema("identity")
}

/// Product taxonomy. Self-referencing to support subcategories.
/// NOTE: real uniqueness on `slug`/`name` is a partial index (see file
/// header) — the @@index below is lookup performance only.
model Category {
  id               String    @id(map: "pk_categories") @default(dbgenerated("shared.uuid_generate_v7()")) @db.Uuid
  parentCategoryId String?   @map("parent_category_id") @db.Uuid
  name             String    @unique(map: "uq_categories_name_active", where: raw("(deleted_at IS NULL)"))
  slug             String    @unique(map: "uq_categories_slug_active", where: raw("(deleted_at IS NULL)"))
  description      String?
  icon             String?
  imageUrl         String?   @map("image_url")
  displayOrder     Int       @default(0) @map("display_order")
  createdByUserId  String?   @map("created_by_user_id") @db.Uuid
  updatedByUserId  String?   @map("updated_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  products Product[]

  @@index([parentCategoryId], map: "idx_categories_parent_category_id")
  @@map("categories")
  @@schema("catalog")
}

/// NOTE: real uniqueness on `slug`/`name` is a partial index (see file
/// header) — the @@index below is lookup performance only.
model Brand {
  id              String    @id(map: "pk_brands") @default(dbgenerated("shared.uuid_generate_v7()")) @db.Uuid
  name            String    @unique(map: "uq_brands_name_active", where: raw("(deleted_at IS NULL)"))
  slug            String    @unique(map: "uq_brands_slug_active", where: raw("(deleted_at IS NULL)"))
  logoUrl         String?   @map("logo_url")
  website         String?
  description     String?
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  updatedByUserId String?   @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  products Product[]

  @@map("brands")
  @@schema("catalog")
}

/// Sellable SKU — commerce fields plus solar-specific technical attributes
/// carried over 1:1 from the current Mongoose model.
/// NOTE: real uniqueness on `slug`/`sku` is a partial index, and full-text
/// search is a GIN index — both are manual SQL (see file header).
/// NOTE: `stockQuantity` is a cached read once the inventory module is
/// active (see DATABASE_SCHEMA.md §10 item 2 / this file's product note) —
/// single source of truth in single-warehouse mode, denormalized cache once
/// StockItem/StockMovement are in use.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Product {
  id              String    @id(map: "pk_products") @default(dbgenerated("shared.uuid_generate_v7()")) @db.Uuid
  categoryId      String    @map("category_id") @db.Uuid
  brandId         String?   @map("brand_id") @db.Uuid
  name            String
  slug            String    @unique(map: "uq_products_slug_active", where: raw("(deleted_at IS NULL)"))
  sku             String    @unique(map: "uq_products_sku_active", where: raw("(deleted_at IS NULL)"))
  description     String?
  price           Decimal   @db.Decimal(12, 2)
  compareAtPrice  Decimal?  @map("compare_at_price") @db.Decimal(12, 2)
  currencyCode    String    @default("AUD") @map("currency_code") @db.Char(3)
  stockQuantity   Int       @default(0) @map("stock_quantity")
  wattage         Decimal?  @db.Decimal(8, 2)
  cellType        CellType? @map("cell_type")
  technology      String?
  frameColor      String?   @map("frame_color")
  cellNumber      String?   @map("cell_number")
  manufacturer    String?
  efficiency      Decimal?  @db.Decimal(5, 2)
  warranty        String?
  datasheetUrl    String?   @map("datasheet_url")
  isFeatured      Boolean   @default(false) @map("is_featured")
  isActive        Boolean   @default(true) @map("is_active")
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  updatedByUserId String?   @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  category  Category       @relation(fields: [categoryId], references: [id])
  brand     Brand?         @relation(fields: [brandId], references: [id])
  images    ProductImage[]
  favourites Favourite[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([categoryId], map: "idx_products_category_id")
  @@index([brandId], map: "idx_products_brand_id")
  @@index([isFeatured], map: "idx_products_is_featured", where: raw("(is_featured = true)"))
  @@index([isActive], map: "idx_products_is_active")
  @@index([categoryId, technology], map: "idx_products_category_technology")
  @@index([categoryId, cellType], map: "idx_products_category_cell_type")
  @@index([wattage], map: "idx_products_wattage")
  @@map("products")
  @@schema("catalog")
}

/// Ordered images, replacing the Mongo `images: [String]` array — a child
/// table supports per-image ordering/alt-text a bare string array couldn't.
model ProductImage {
  id           String   @id(map: "pk_product_images") @default(dbgenerated("shared.uuid_generate_v7()")) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  url          String
  altText      String?  @map("alt_text")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id])

  @@index([productId], map: "idx_product_images_product_id")
  @@map("product_images")
  @@schema("catalog")
}

/// One active working cart per user. Ephemeral — no audit, no soft delete.
model Cart {
  id        String   @id(map: "pk_carts") @default(dbgenerated("shared.uuid_generate_v7()")) @db.Uuid
  userId    String   @unique(map: "uq_carts_user_id") @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  items CartItem[]

  @@map("carts")
  @@schema("commerce")
}

model CartItem {
  id        String   @id(map: "pk_cart_items") @default(dbgenerated("shared.uuid_generate_v7()")) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  cart    Cart    @relation(fields: [cartId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId], map: "uq_cart_items_cart_product")
  @@index([productId], map: "idx_cart_items_product_id")
  @@map("cart_items")
  @@schema("commerce")
}

/// The financial/legal record of a placed order. Belongs to the Organization
/// (the paying entity), with an optional pointer to the individual who
/// placed it. GST convention: subtotal is GST-exclusive, total is
/// GST-inclusive, taxRate is snapshotted at order time (see file's GST note
/// in DATABASE_SCHEMA.md §0). Never deleted, soft or hard — cancellation is
/// a status value. Enforcement: orderItems relation is Restrict, and every
/// order always has at least one item, so an order can never be deleted at
/// the DB level without first manually deleting its items.
model Order {
  id                      String      @id(map: "pk_orders") @default(dbgenerated("shared.uuid_generate_v7()")) @db.Uuid
  orderNumber             String      @unique(map: "uq_orders_order_number") @map("order_number")
  organizationId          String      @map("organization_id") @db.Uuid
  placedByUserId          String?     @map("placed_by_user_id") @db.Uuid
  status                  OrderStatus @default(pending_payment)
  currencyCode            String      @default("AUD") @map("currency_code") @db.Char(3)
  subtotal                Decimal     @db.Decimal(12, 2)
  taxRate                 Decimal     @default(0.1000) @map("tax_rate") @db.Decimal(5, 4)
  taxAmount               Decimal     @map("tax_amount") @db.Decimal(12, 2)
  total                   Decimal     @db.Decimal(12, 2)
  shippingAddressId       String?     @map("shipping_address_id") @db.Uuid
  shippingAddressSnapshot Json?       @map("shipping_address_snapshot")
  billingAddressSnapshot  Json        @map("billing_address_snapshot")
  notes                   String?
  internalNotes           String?     @map("internal_notes")
  stripeCheckoutSessionId String?     @map("stripe_checkout_session_id")
  stripePaymentIntentId   String?     @map("stripe_payment_intent_id")
  placedAt                DateTime    @default(now()) @map("placed_at") @db.Timestamptz(6)
  updatedByUserId         String?     @map("updated_by_user_id") @db.Uuid
  createdAt               DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  packingSlipNumber       String?     @map("packing_slip_number")

  items OrderItem[]

  @@index([organizationId, placedAt(sort: Desc)], map: "idx_orders_organization_id_placed_at")
  @@index([status], map: "idx_orders_status")
  @@index([stripePaymentIntentId], map: "idx_orders_stripe_payment_intent_id")
  @@map("orders")
  @@schema("commerce")
}

/// Immutable line items — the "snapshot at time of order" pattern from the
/// current Mongoose model, carried over exactly: never trust a live product
/// price for a historical record. No updatedAt, no soft delete, by design —
/// a correction is a new order or a credit note, never an UPDATE.
model OrderItem {
  id                  String   @id(map: "pk_order_items") @default(dbgenerated("shared.uuid_generate_v7()")) @db.Uuid
  orderId             String   @map("order_id") @db.Uuid
  productId           String   @map("product_id") @db.Uuid
  productNameSnapshot String   @map("product_name_snapshot")
  productSkuSnapshot  String   @map("product_sku_snapshot")
  unitPriceSnapshot   Decimal  @map("unit_price_snapshot") @db.Decimal(12, 2)
  quantity            Int
  lineTotal           Decimal  @map("line_total") @db.Decimal(12, 2)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId], map: "idx_order_items_order_id")
  @@index([productId], map: "idx_order_items_product_id")
  @@map("order_items")
  @@schema("commerce")
}

model Favourite {
  id        String   @id(map: "pk_favourites") @default(dbgenerated("shared.uuid_generate_v7()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId], map: "uq_favourites_user_product")
  @@index([productId], map: "idx_favourites_product_id")
  @@map("favourites")
  @@schema("commerce")
}

/// A person at an organization for sales/relationship purposes — not every
/// contact has portal login (linkedUserId is null until one is granted).
/// NOTE: real uniqueness on (organizationId, lower(email)) is a partial
/// index (see file header) — the @@index below is lookup performance only.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Contact {
  id              String    @id(map: "pk_contacts") @default(dbgenerated("shared.uuid_generate_v7()")) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  linkedUserId    String?   @map("linked_user_id") @db.Uuid
  fullName        String    @map("full_name")
  email           String?
  phone           String?
  jobTitle        String?   @map("job_title")
  isPrimary       Boolean   @default(false) @map("is_primary")
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  updatedByUserId String?   @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([organizationId], map: "idx_contacts_organization_id")
  @@index([linkedUserId], map: "idx_contacts_linked_user_id")
  @@map("contacts")
  @@schema("crm")
}

/// A pre-qualification prospect — may not correspond to a real Organization
/// yet. Single `organizationId` column, populated on conversion (an earlier
/// draft had a redundant separate `convertedOrganizationId` column — see
/// DATABASE_SCHEMA.md §10 item 10 — collapsed to one column here).
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Lead {
  id                 String     @id(map: "pk_leads") @default(dbgenerated("shared.uuid_generate_v7()")) @db.Uuid
  organizationId     String?    @map("organization_id") @db.Uuid
  companyNameRaw     String?    @map("company_name_raw")
  contactNameRaw     String?    @map("contact_name_raw")
  emailRaw           String?    @map("email_raw")
  phoneRaw           String?    @map("phone_raw")
  source             String?
  installsPerWeekRaw String?    @map("installs_per_week_raw")
  status             LeadStatus @default(new)
  ownerUserId        String?    @map("owner_user_id") @db.Uuid
  convertedAt        DateTime?  @map("converted_at") @db.Timestamptz(6)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?  @map("deleted_at") @db.Timestamptz(6)

  @@index([status], map: "idx_leads_status")
  @@index([ownerUserId], map: "idx_leads_owner_user_id")
  @@map("leads")
  @@schema("crm")
}

/// An active sales pipeline record against a qualified organization.
model Opportunity {
  id                String           @id(map: "pk_opportunities") @default(dbgenerated("shared.uuid_generate_v7()")) @db.Uuid
  organizationId    String           @map("organization_id") @db.Uuid
  primaryContactId  String?          @map("primary_contact_id") @db.Uuid
  ownerUserId       String           @map("owner_user_id") @db.Uuid
  stage             OpportunityStage @default(prospecting)
  estimatedValue    Decimal?         @map("estimated_value") @db.Decimal(12, 2)
  currencyCode      String           @default("AUD") @map("currency_code") @db.Char(3)
  expectedCloseDate DateTime?        @map("expected_close_date") @db.Date
  closedAt          DateTime?        @map("closed_at") @db.Timestamptz(6)
  lostReason        String?          @map("lost_reason")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?        @map("deleted_at") @db.Timestamptz(6)

  @@index([organizationId], map: "idx_opportunities_organization_id")
  @@index([ownerUserId], map: "idx_opportunities_owner_user_id")
  @@index([stage], map: "idx_opportunities_stage")
  @@map("opportunities")
  @@schema("crm")
}

/// A versioned, time-bound price offer; converts into an Order on acceptance
/// using the same snapshot discipline as OrderItem. Soft-deletable only
/// while status = 'draft' — application logic (ideally backed by a trigger,
/// see file header) should block soft-delete/edit once sent/accepted/converted.
model Quote {
  id               String      @id(map: "pk_quotes") @default(dbgenerated("shared.uuid_generate_v7()")) @db.Uuid
  organizationId   String      @map("organization_id") @db.Uuid
  opportunityId    String?     @map("opportunity_id") @db.Uuid
  quoteNumber      String      @unique(map: "uq_quotes_quote_number") @map("quote_number")
  version          Int         @default(1)
  status           QuoteStatus @default(draft)
  validUntil       DateTime?   @map("valid_until") @db.Date
  subtotal         Decimal     @default(0) @db.Decimal(12, 2)
  total            Decimal     @default(0) @db.Decimal(12, 2)
  currencyCode     String      @default("AUD") @map("currency_code") @db.Char(3)
  convertedOrderId String?     @map("converted_order_id") @db.Uuid
  createdByUserId  String?     @map("created_by_user_id") @db.Uuid
  updatedByUserId  String?     @map("updated_by_user_id") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?   @map("deleted_at") @db.Timestamptz(6)

  @@index([organizationId], map: "idx_quotes_organization_id")
  @@index([opportunityId], map: "idx_quotes_opportunity_id")
  @@index([status], map: "idx_quotes_status")
  @@map("quotes")
  @@schema("crm")
}

model QuoteItem {
  id                  String   @id(map: "pk_quote_items") @default(dbgenerated("shared.uuid_generate_v7()")) @db.Uuid
  quoteId             String   @map("quote_id") @db.Uuid
  productId           String   @map("product_id") @db.Uuid
  productNameSnapshot String   @map("product_name_snapshot")
  unitPriceSnapshot   Decimal  @map("unit_price_snapshot") @db.Decimal(12, 2)
  quantity            Int
  lineTotal           Decimal  @map("line_total") @db.Decimal(12, 2)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([quoteId], map: "idx_quote_items_quote_id")
  @@map("quote_items")
  @@schema("crm")
}

/// Unified, polymorphic timeline entry (call/email/meeting/note/task)
/// against any CRM entity. `entityId` intentionally has NO foreign key —
/// Postgres/Prisma can't constrain a column to point at one of several
/// possible tables. See DATABASE_SCHEMA.md §10 item 5 for the accepted
/// trade-off and mitigation (periodic orphan-check job).
model Activity {
  id              String       @id(map: "pk_activities") @default(dbgenerated("shared.uuid_generate_v7()")) @db.Uuid
  entityType      String       @map("entity_type")
  entityId        String       @map("entity_id") @db.Uuid
  activityType    ActivityType @map("activity_type")
  subject         String?
  body            String?
  dueAt           DateTime?    @map("due_at") @db.Timestamptz(6)
  completedAt     DateTime?    @map("completed_at") @db.Timestamptz(6)
  ownerUserId     String?      @map("owner_user_id") @db.Uuid
  createdByUserId String?      @map("created_by_user_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?    @map("deleted_at") @db.Timestamptz(6)

  @@index([entityType, entityId], map: "idx_activities_entity")
  @@index([ownerUserId], map: "idx_activities_owner_user_id")
  @@index([dueAt], map: "idx_activities_due_at")
  @@map("activities")
  @@schema("crm")
}

/// NOTE: real uniqueness on `code` is a partial index (see file header) —
/// the @@index below is lookup performance only.
model Warehouse {
  id              String    @id(map: "pk_warehouses") @default(dbgenerated("shared.uuid_generate_v7()")) @db.Uuid
  name            String
  code            String    @unique(map: "uq_warehouses_code_active", where: raw("(deleted_at IS NULL)"))
  addressId       String    @map("address_id") @db.Uuid
  isActive        Boolean   @default(true) @map("is_active")
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  updatedByUserId String?   @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([addressId], map: "idx_warehouses_address_id")
  @@map("warehouses")
  @@schema("inventory")
}

/// Current on-hand/reserved quantity per product per warehouse — a read
/// model; historical truth lives in StockMovement. `version` is an
/// optimistic-concurrency hook — the actual locking pattern (SELECT FOR
/// UPDATE vs. version check) must be nailed down in application code before
/// this ships (see DATABASE_SCHEMA.md §10 item 3 — schema hook, not a guarantee).
model StockItem {
  id               String   @id(map: "pk_stock_items") @default(dbgenerated("shared.uuid_generate_v7()")) @db.Uuid
  warehouseId      String   @map("warehouse_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  quantityOnHand   Int      @default(0) @map("quantity_on_hand")
  quantityReserved Int      @default(0) @map("quantity_reserved")
  reorderPoint     Int      @default(0) @map("reorder_point")
  version          Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([warehouseId, productId], map: "uq_stock_items_warehouse_product")
  @@map("stock_items")
  @@schema("inventory")
}

/// Append-only ledger of every stock change — the source of truth, mirroring
/// the credit-ledger pattern for the same correctness reasons. No updatedAt,
/// no soft delete — a mistaken movement is corrected with a new offsetting
/// movement, never edited. `referenceId` has no FK — polymorphic, same
/// trade-off as Activity.entityId.
model StockMovement {
  id              String            @id(map: "pk_stock_movements") @default(dbgenerated("shared.uuid_generate_v7()")) @db.Uuid
  warehouseId     String            @map("warehouse_id") @db.Uuid
  productId       String            @map("product_id") @db.Uuid
  movementType    StockMovementType @map("movement_type")
  quantityDelta   Int               @map("quantity_delta")
  referenceType   String?           @map("reference_type")
  referenceId     String?           @map("reference_id") @db.Uuid
  note            String?
  createdByUserId String?           @map("created_by_user_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([warehouseId, productId, createdAt], map: "idx_stock_movements_warehouse_product")
  @@index([referenceType, referenceId], map: "idx_stock_movements_reference")
  @@map("stock_movements")
  @@schema("inventory")
}

/// Installer businesses, modeled as a `type = 'partner'` Organization rather
/// than a duplicate company/contact/address structure.
/// NOTE: real uniqueness on `organizationId` is a partial index (see file
/// header) — the @unique below is a placeholder full constraint until that
/// manual migration step is applied.
model Installer {
  id                  String          @id(map: "pk_installers") @default(dbgenerated("shared.uuid_generate_v7()")) @db.Uuid
  organizationId      String          @unique(map: "uq_installers_org_active", where: raw("(deleted_at IS NULL)")) @map("organization_id") @db.Uuid
  licenseNumber       String?         @map("license_number")
  certificationExpiry DateTime?       @map("certification_expiry") @db.Date
  serviceRadiusKm     Int?            @map("service_radius_km")
  status              InstallerStatus @default(pending_approval)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?       @map("deleted_at") @db.Timestamptz(6)

  @@map("installers")
  @@schema("inventory")
}

/// Operational bridge linking a placed order to an assigned installer.
model InstallationJob {
  id              String                @id(map: "pk_installation_jobs") @default(dbgenerated("shared.uuid_generate_v7()")) @db.Uuid
  orderId         String                @map("order_id") @db.Uuid
  installerId     String?               @map("installer_id") @db.Uuid
  status          InstallationJobStatus @default(scheduled)
  scheduledDate   DateTime?             @map("scheduled_date") @db.Date
  completedAt     DateTime?             @map("completed_at") @db.Timestamptz(6)
  notes           String?
  createdByUserId String?               @map("created_by_user_id") @db.Uuid
  updatedByUserId String?               @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?             @map("deleted_at") @db.Timestamptz(6)

  @@index([orderId], map: "idx_installation_jobs_order_id")
  @@index([installerId], map: "idx_installation_jobs_installer_id")
  @@index([status], map: "idx_installation_jobs_status")
  @@map("installation_jobs")
  @@schema("inventory")
}

/// One credit facility per organization. `cachedBalance` is a derived,
/// recomputable read — CreditLedgerEntry is the source of truth. See
/// DATABASE_SCHEMA.md §10 item 2 — requires a reconciliation job, not optional.
/// NOTE: real uniqueness on `organizationId` is a partial index (see file
/// header) — the @unique below is a placeholder until that migration step.
model CreditAccount {
  id              String              @id(map: "pk_credit_accounts") @default(dbgenerated("shared.uuid_generate_v7()")) @db.Uuid
  organizationId  String              @unique(map: "uq_credit_accounts_org_active", where: raw("(deleted_at IS NULL)")) @map("organization_id") @db.Uuid
  creditLimit     Decimal             @default(0) @map("credit_limit") @db.Decimal(12, 2)
  currencyCode    String              @default("AUD") @map("currency_code") @db.Char(3)
  cachedBalance   Decimal             @default(0) @map("cached_balance") @db.Decimal(12, 2)
  status          CreditAccountStatus @default(active)
  createdByUserId String?             @map("created_by_user_id") @db.Uuid
  updatedByUserId String?             @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?           @map("deleted_at") @db.Timestamptz(6)

  @@map("credit_accounts")
  @@schema("billing")
}

/// Append-only debit/credit ledger — the actual source of truth for
/// balance. No updatedAt, no soft delete — a correction is a new offsetting
/// entry. Sign convention: positive = charge (increases owed balance),
/// negative = payment/credit. `referenceId` has no FK — polymorphic.
model CreditLedgerEntry {
  id              String                @id(map: "pk_credit_ledger_entries") @default(dbgenerated("shared.uuid_generate_v7()")) @db.Uuid
  creditAccountId String                @map("credit_account_id") @db.Uuid
  entryType       CreditLedgerEntryType @map("entry_type")
  amount          Decimal               @db.Decimal(12, 2)
  referenceType   String?               @map("reference_type")
  referenceId     String?               @map("reference_id") @db.Uuid
  description     String?
  createdByUserId String?               @map("created_by_user_id") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([creditAccountId, createdAt], map: "idx_credit_ledger_entries_account_id_created_at")
  @@map("credit_ledger_entries")
  @@schema("billing")
}

/// No `deletedAt` — a mistaken invoice is voided (status = 'void'), never
/// deleted. Enforcement: invoiceItems relation is Restrict, making
/// hard-deleting an invoice structurally impossible, same mechanism as Order.
/// GST convention matches Order — see file's GST note above.
model Invoice {
  id              String        @id(map: "pk_invoices") @default(dbgenerated("shared.uuid_generate_v7()")) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  orderId         String?       @map("order_id") @db.Uuid
  invoiceNumber   String        @unique(map: "uq_invoices_invoice_number") @map("invoice_number")
  status          InvoiceStatus @default(draft)
  currencyCode    String        @default("AUD") @map("currency_code") @db.Char(3)
  subtotal        Decimal       @db.Decimal(12, 2)
  taxRate         Decimal       @default(0.1000) @map("tax_rate") @db.Decimal(5, 4)
  taxTotal        Decimal       @default(0) @map("tax_total") @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)
  dueDate         DateTime?     @map("due_date") @db.Date
  issuedAt        DateTime?     @map("issued_at") @db.Timestamptz(6)
  paidAt          DateTime?     @map("paid_at") @db.Timestamptz(6)
  createdByUserId String?       @map("created_by_user_id") @db.Uuid
  updatedByUserId String?       @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([organizationId], map: "idx_invoices_organization_id")
  @@index([status], map: "idx_invoices_status")
  @@index([orderId], map: "idx_invoices_order_id")
  @@map("invoices")
  @@schema("billing")
}

/// No updatedAt, no soft delete — immutable, same discipline as OrderItem.
model InvoiceItem {
  id          String   @id(map: "pk_invoice_items") @default(dbgenerated("shared.uuid_generate_v7()")) @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  description String
  quantity    Int
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  lineTotal   Decimal  @map("line_total") @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([invoiceId], map: "idx_invoice_items_invoice_id")
  @@map("invoice_items")
  @@schema("billing")
}

/// No deletedAt — payments are never deleted. A refund is a new row
/// pointing back at the original via `refundedPaymentId`, not a mutation of it.
model Payment {
  id                    String        @id(map: "pk_payments") @default(dbgenerated("shared.uuid_generate_v7()")) @db.Uuid
  organizationId        String        @map("organization_id") @db.Uuid
  orderId               String?       @map("order_id") @db.Uuid
  invoiceId             String?       @map("invoice_id") @db.Uuid
  refundedPaymentId     String?       @map("refunded_payment_id") @db.Uuid
  amount                Decimal       @db.Decimal(12, 2)
  currencyCode          String        @default("AUD") @map("currency_code") @db.Char(3)
  method                PaymentMethod
  status                PaymentStatus @default(pending)
  stripePaymentIntentId String?       @map("stripe_payment_intent_id")
  stripeChargeId        String?       @map("stripe_charge_id")
  failureReason         String?       @map("failure_reason")
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([organizationId], map: "idx_payments_organization_id")
  @@index([orderId], map: "idx_payments_order_id")
  @@index([invoiceId], map: "idx_payments_invoice_id")
  @@index([stripePaymentIntentId], map: "idx_payments_stripe_payment_intent_id")
  @@map("payments")
  @@schema("billing")
}

/// Webhook event deduplication — stores Stripe event IDs to ensure
/// idempotent processing. No updatedAt, no soft delete — processed event
/// records are kept for audit purposes and trimmed by a periodic cleanup
/// job (retain 90 days).
model StripeEvent {
  id             String   @id(map: "pk_stripe_events") @default(dbgenerated("shared.uuid_generate_v7()")) @db.Uuid
  stripeEventId  String   @unique(map: "uq_stripe_events_stripe_event_id") @map("stripe_event_id")
  eventType      String   @map("event_type")
  payload        Json?    @map("payload")
  processedAt    DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("stripe_events")
  @@schema("billing")
}

/// Immutable "who did what to what, when" record. No updatedAt, no soft
/// delete — append-only by definition, enforced via REVOKE UPDATE, DELETE
/// on the application's runtime role (manual SQL, see file header).
/// `actorId`/`organizationId` intentionally have NO foreign key — audit rows
/// must survive even if the referenced row is later (in principle) removed,
/// and an actor may be 'system'/'api_key' with no user row at all.
model AuditLog {
  id             String         @id(map: "pk_audit_log") @default(dbgenerated("shared.uuid_generate_v7()")) @db.Uuid
  actorId        String?        @map("actor_id") @db.Uuid
  actorType      AuditActorType @map("actor_type")
  organizationId String?        @map("organization_id") @db.Uuid
  action         String
  entityType     String         @map("entity_type")
  entityId       String         @map("entity_id") @db.Uuid
  beforeData     Json?          @map("before_data")
  afterData      Json?          @map("after_data")
  ipAddress      String?        @map("ip_address") @db.Inet
  userAgent      String?        @map("user_agent")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entityType, entityId, createdAt], map: "idx_audit_log_entity")
  @@index([organizationId, createdAt], map: "idx_audit_log_organization_id_created_at")
  @@index([actorId], map: "idx_audit_log_actor_id")
  @@map("audit_log")
  @@schema("audit")
}

enum OrganizationType {

  won
  lost

  @@map("opportunity_stage_enum")
  @@schema("crm")
}

enum QuoteStatus {
  draft
  sent
  accepted
  rejected
  expired
  converted

  @@map("quote_status_enum")
  @@schema("crm")
}

enum ActivityType {
  call
  email
  meeting
  note
  task

  @@map("activity_type_enum")
  @@schema("crm")
}

enum StockMovementType {
  receipt
  sale
  return
  adjustment
  transfer_in
  transfer_out
  reservation
  release

  @@map("stock_movement_type_enum")
  @@schema("inventory")
}

enum InstallerStatus {
  pending_approval
  active
  suspended
  inactive

  @@map("installer_status_enum")
  @@schema("inventory")
}

enum InstallationJobStatus {
  scheduled
  in_progress
  completed
  cancelled

  @@map("installation_job_status_enum")
  @@schema("inventory")
}

enum CreditAccountStatus {
  active
